#!/usr/bin/env python3
import asyncio
import logging
import random

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger('TriggerScheduler')

class TriggerScheduler:
    def __init__(self, worker_id='edge-node-02'):
        self.worker_id = worker_id

    async def check_triggers(self):
        await asyncio.sleep(0.02)
        tasks = [
            {'id': f'scheduled_{i+1}', 'type': random.choice(['lead_capture', 'content_sync', 'payout'])}
            for i in range(random.randint(1, 3))
        ]
        logger.info(f'[{self.worker_id}] tasks={tasks}')
        return tasks

async def main():
    scheduler = TriggerScheduler()
    for _ in range(3):
        await scheduler.check_triggers()

if __name__ == '__main__':
    asyncio.run(main())
